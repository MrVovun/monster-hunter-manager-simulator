  questionResponses:
  - question: {fileID: 11400000, guid: 138b37c003abe654ab951864f1f191f4, type: 2}
    tagIndex: 0
    responseText: A cadavre! Like it rose from dead.
  - question: {fileID: 11400000, guid: 88be2b18d86528f459bb4d4d5a2e53bd, type: 2}
    tagIndex: 1
    responseText: Like a regular human.
  - question: {fileID: 11400000, guid: 7052173e211d8fd4e8ab035dc4d434b2, type: 2}
    tagIndex: 2
    responseText: Completely silent, only grunts and groans!
  - question: {fileID: 11400000, guid: 7b7c77071c297ff46a62a80d5d33bb78, type: 2}
    tagIndex: 3
    responseText: Do corpses have tails?
  - question: {fileID: 11400000, guid: e301b93ebccd4d544ac650ee3653046d, type: 2}
    tagIndex: 4
    responseText: Nothing like that.
  - question: {fileID: 11400000, guid: ac95fca6036908f4e82a3a5014cb5c38, type: 2}
    tagIndex: 5
    responseText: Like it dragged its own dead body.
